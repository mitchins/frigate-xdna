{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mitchins/frigate-xdna/schemas/status.schema.json",
  "title": "frigate-xdna service status",
  "type": "object",
  "required": ["schema_version", "service", "version", "build", "state"],
  "properties": {
    "schema_version": {"const": 1},
    "service": {"const": "frigate-xdna"},
    "version": {"type": "string"},
    "build": {
      "type": "object",
      "required": ["version", "revision", "channel"],
      "properties": {
        "version": {"type": "string"},
        "revision": {"type": "string"},
        "channel": {"enum": ["development", "release-candidate",
                             "release"]}
      }
    },
    "state": {
      "type": "string",
      "enum": ["STARTING", "SERVING", "DEGRADED", "INHIBITED",
               "STOPPING", "NOT_IMPLEMENTED"]
    },
    "active": {
      "type": ["object", "null"],
      "properties": {
        "ref": {"type": "string"},
        "compile_key": {"type": "string"},
        "serving_digest": {"type": "string"},
        "generation": {"type": "integer", "minimum": 0},
        "worker_pid": {"type": "integer"},
        "uptime_s": {"type": "number", "minimum": 0},
        "worker_rss_kb": {"type": "integer", "minimum": 0}
      },
      "required": ["ref", "compile_key", "serving_digest", "generation"]
    },
    "worker": {
      "type": ["object", "null"],
      "description": "Live resident worker binding, or null when no worker serves.",
      "properties": {
        "compile_key": {"type": ["string", "null"]},
        "generation": {"type": "integer", "minimum": 0},
        "serving_digest": {"type": ["string", "null"]},
        "loaded": {"type": "boolean"},
        "alive": {"type": "boolean"}
      }
    },
    "ready": {"type": "boolean",
              "description": "Inference readiness: loaded, alive, permitted worker, no inhibition."},
    "reason": {"type": "string",
               "description": "Human reason for the current readiness value."},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "source_sha256", "state"],
        "properties": {
          "ref": {"type": "string"},
          "source_sha256": {"type": "string"},
          "state": {
            "type": "string",
            "enum": ["NEW", "FETCHING", "DOWNLOADED", "INSPECTED", "QUEUED",
                     "WAITING_FOR_DEVICE", "COMPILING", "PREPARED",
                     "ACTIVATING", "VERIFIED", "ACTIVE", "DRAINING",
                     "INACTIVE_VERIFIED", "AUTH_FAILED", "DOWNLOAD_FAILED",
                     "UNSUPPORTED_CONTRACT", "COMPILE_FAILED",
                     "RESOURCE_EXCEEDED", "VALIDATION_FAILED",
                     "SOURCE_CHANGED", "CACHE_CORRUPT", "QUARANTINED",
                     "INTERRUPTED", "DEVICE_BUSY", "DEVICE_FAULT",
                     "SAFETY_INHIBITED"]
          },
          "phase": {"type": ["string", "null"],
                    "description": "Current preparation sub-phase, if any."},
          "elapsed_s": {"type": ["number", "null"],
                        "description": "Measured seconds in the current phase, if any."},
          "verified": {"type": "boolean",
                       "description": "A native check (in-compile probe or activation LOAD) is recorded for this artifact."},
          "error_code": {"type": ["string", "null"]},
          "compile_key": {"type": ["string", "null"]},
          "attempts": {"type": "integer", "minimum": 0},
          "retryable": {"type": "boolean"},
          "inspection": {
            "type": ["object", "null"],
            "description": "Last graph-inspection summary for this ref (compatible flag, input geometry, output profile, class count, refusal reason). Null when never inspected. Numeric class IDs only; label names are never inferred.",
            "properties": {
              "compatible": {"type": "boolean"},
              "reason": {"type": ["string", "null"]},
              "input": {"type": ["string", "null"]},
              "input_dtype": {"type": ["string", "null"]},
              "layout": {"type": ["string", "null"]},
              "profile": {"type": ["string", "null"]},
              "output": {"type": ["string", "null"]},
              "class_count": {"type": ["integer", "null"]}
            }
          },
          "failure": {
            "type": ["object", "null"],
            "description": "Structured failure record of the newest terminal job, if any.",
            "properties": {
              "phase": {"type": "string"},
              "code": {"type": "string"},
              "reason": {"type": "string"},
              "kind": {"type": "string"},
              "guidance": {"type": "string"},
              "attempts": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "jobs": {"type": "array", "description": "Task 02: job records per CACHE.md §3"},
    "inhibition": {"type": ["object", "null"],
                   "description": "Task 02/04: safety inhibition record or null"},
    "counters": {"type": "object",
                 "description": "Task 02/04: request/latency/cache counters"}
  }
}
