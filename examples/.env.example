# Example environment for the frigate-xdna appliance.
# Copy to .env (untracked) and fill in real values. Never commit secrets.
FXDNA_IMAGE=ghcr.io/mitchins/frigate-xdna:0.1.2
FXDNA_MODELS=plus://REPLACE_CURRENT_ID,plus://REPLACE_NEXT_ID
# Obtain from the Docker host: stat -c '%g' /dev/accel/accel0
NPU_GID=REPLACE_WITH_NUMERIC_GROUP_ID
# Host model directory (a directory of .onnx files), mounted read-only
# at /models inside the container. Only used with compose.local.yaml;
# local://NAME then resolves to <dir>/NAME.onnx.
# FXDNA_MODEL_HOST_DIR=/srv/frigate/models
# Local example for compose.local.yaml (use instead of the Plus
# FXDNA_MODELS above):
# FXDNA_MODELS=local://yolov9-t-320
# Only used with compose.host-port.yaml:
FXDNA_BIND_IP=127.0.0.1
# Plus credential (container environment): reuse the key already
# configured for Frigate. Only used with compose.plus.yaml.
PLUS_API_KEY=REPLACE_WITH_PLUS_KEY
